{
    "name": "web-notebook",
    "displayName": "Web Notebook",
    "description": "A notebook renderer for basic web code (HTML/CSS/JavaScript)",
    "version": "1.1.0",
    "publisher": "oney",
    "repository": {
        "type": "git",
        "url": "https://github.com/soney/vscode-webnb.git"
    },
    "license": "MIT",
    "icon": "icons/webnb-icon.png",
    "engines": {
        "vscode": "^1.125.0",
        "node": "^22.18.0 || >=24.11.0"
    },
    "keywords": [
        "notebook",
        "tutorial",
        "interactive",
        "markdown",
        "education"
    ],
    "categories": [
        "Notebooks",
        "Education"
    ],
    "activationEvents": [
        "onNotebook:web-notebook",
        "onLanguage:webnb"
    ],
    "main": "./out/extension/extension.js",
    "browser": "./out/extension/extension.web.js",
    "extensionKind": [
        "workspace"
    ],
    "contributes": {
        "notebooks": [
            {
                "id": "web-notebook",
                "type": "web-notebook",
                "displayName": "Web Notebook",
                "selector": [
                    {
                        "filenamePattern": "*.webnb"
                    }
                ]
            }
        ],
        "notebookRenderer": [
            {
                "id": "practical-javascript-reading-notebook",
                "entrypoint": "./out/client/index.js",
                "displayName": "practical-javascript-reading-notebook",
                "requiresMessaging": "optional",
                "mimeTypes": [
                    "x-application/webnb-output"
                ]
            },
            {
                "id": "webnb-markdown-extensions",
                "displayName": "Web Notebook markdown extensions",
                "entrypoint": {
                    "extends": "vscode.markdown-it-renderer",
                    "path": "./out/markdownItPlugin/index.js"
                },
                "requiresMessaging": "optional"
            }
        ],
        "languages": [
            {
                "id": "webnb",
                "extensions": [
                    ".webnb"
                ],
                "icon": {
                    "light": "./icons/webnb-icon.svg",
                    "dark": "./icons/webnb-icon.svg"
                }
            }
        ],
        "commands": [
            {
                "command": "webnb.restoreNotebook",
                "category": "Web Notebook",
                "title": "Restore Notebook to Starter State",
                "icon": "$(discard)"
            }
        ],
        "menus": {
            "notebook/toolbar": [
                {
                    "command": "webnb.restoreNotebook",
                    "group": "navigation",
                    "when": "notebookType == 'web-notebook'"
                }
            ],
            "editor/title": [
                {
                    "command": "webnb.restoreNotebook",
                    "group": "navigation",
                    "when": "notebookType == 'web-notebook' && config.notebook.globalToolbar != true"
                }
            ]
        },
        "configuration": {
            "title": "Web-Notebook",
            "properties": {
                "webnb.lockCellStructure": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Prevent cells from being added, removed, or reordered in Web Notebooks. Cell contents stay editable, so learners can still edit code examples and answer multiple choice questions. Turn this off to author a notebook."
                },
                "webnb.allowRevealingSolutions": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "markdownDescription": "Give readers the option to reveal solutions: code cells with a `+solution` addon get a \"View solution\" button, and multiple choice cells get a \"Show Answer\" button. The solution appears only when the reader clicks. Turn this off to remove those buttons entirely (for example, during an assessment). Cells that are already rendered refresh automatically when this changes."
                },
                "webnb.lockMarkdown": {
                    "type": "boolean",
                    "default": false,
                    "scope": "resource",
                    "markdownDescription": "Prevent the markdown (text) cells of Web Notebooks from being edited, so a notebook's instructions stay intact. Code cells stay editable and runnable. This sits between `#webnb.lockCellStructure#`, which only locks the cell layout, and `#webnb.readOnly#`, which makes the whole file untouchable."
                },
                "webnb.readOnly": {
                    "type": "boolean",
                    "default": false,
                    "scope": "window",
                    "markdownDescription": "Make `.webnb` notebooks fully read-only, for notebooks meant purely for reading. This is much stricter than `#webnb.lockCellStructure#`: cell contents cannot be edited, and nothing the notebook records (a saved multiple choice answer, terminal history) can be written back to the file. Enabling this adds the `**/*.webnb` pattern to `#files.readonlyInclude#`, the VS Code setting that actually marks the files read-only, in the same settings scope where this is turned on; turning it off removes only what it added."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "webpack --mode production",
        "compile-dev": "webpack --mode development",
        "lint": "eslint src --max-warnings 0",
        "watch": "webpack --mode development --watch",
        "pretest": "webpack --mode development && npm run lint",
        "test-web": "node scripts/vscode-test-web.js samplenotebooks/sample.webnb",
        "in-browser": "npm run compile-dev && node scripts/vscode-test-web.js samplenotebooks/sample.webnb",
        "in-browser:open": "node scripts/vscode-test-web.js samplenotebooks/sample.webnb",
        "in-browser:watch": "node scripts/vscode-test-web.js samplenotebooks/sample.webnb --watch",
        "in-browser:remote": "node scripts/vscode-test-web.js samplenotebooks/sample.webnb --watch --remote",
        "dev:web": "npm run watch",
        "test": "vscode-test",
        "gen-vsix": "npm run compile && vsce package --no-dependencies -o web-notebook.vsix",
        "check:vsix": "node scripts/check-vsix.js",
        "coursera:import": "node scripts/coursera-docker-dev.js import",
        "coursera:start": "node scripts/coursera-docker-dev.js start",
        "coursera:stop": "node scripts/coursera-docker-dev.js stop",
        "preview": "vite --config preview/vite.config.ts",
        "test:unit": "tsc -p src/test && mocha --require out/test/test/setup/vscodeHook.js \"out/test/test/unit/**/*.test.js\" \"out/test/test/host/**/*.test.js\" out/test/test/extension.test.js",
        "test:harness": "node tests/harness/run.js",
        "verify:notebooks": "node scripts/verify-notebooks.js",
        "test:harness:update": "node tests/harness/run.js --update",
        "test:browser": "node tests/browser/run.js",
        "test:all": "npm run test:unit && npm run test:harness && npm run test:browser"
    },
    "devDependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.43.13",
        "@types/convert-source-map": "^2.0.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "26.x",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/vscode": "1.125.0",
        "@types/vscode-notebook-renderer": "^1.72.4",
        "@types/webpack-env": "^1.18.8",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/test-web": "^0.0.81",
        "@vscode/vsce": "^4.0.0",
        "chokidar": "^5.0.0",
        "codemirror": "^6.0.2",
        "eslint": "^10.11.0",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "mocha": "^12.0.2",
        "playwright": "^1.63.0",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    },
    "dependencies": {
        "@babel/standalone": "^8.0.6",
        "@xterm/xterm": "^6.0.0",
        "highlight.js": "^11.12.0",
        "marked": "^18.0.14",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "smartypants": "^0.2.2"
    }
}
