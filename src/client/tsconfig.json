{
    "extends": "../tsconfig-base.json",
    "compilerOptions": {
        // noEmit prevents the default tsc from building this--we use webpack instead
        "noEmit": true,
        "rootDir": "..",
        "module": "esnext",
        "moduleResolution": "bundler",
        // ES2020 for the shared modules this renderer imports (String.matchAll in
        // filePaths.ts); notebook webviews run a current Chromium.
        "lib": ["ES2020", "dom"],
        "types": ["webpack-env", "vscode-notebook-renderer"],
    }
}
